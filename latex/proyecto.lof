\contentsline {figure}{\numberline {1}{\ignorespaces Grafo de transición de estados individuales en el sistema estocástico.}}{4}{}%
\contentsline {figure}{\numberline {2}{\ignorespaces Representación en árbol de ramificación de Galton-Watson multitipo a lo largo de 3 generaciones. Los nodos azules representan individuos sanos ($S$), los rojos enfermos ($I$) y los grises punteados ($\dagger $) corresponden a ramas extinguidas por muerte prematura.}}{4}{}%
\contentsline {figure}{\numberline {3}{\ignorespaces Trayectoria temporal de la población en una única realización del Caso Base sin intervención farmacológica ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja) hasta la absorción en $N=0$.}}{8}{}%
\contentsline {figure}{\numberline {4}{\ignorespaces Trayectoria temporal de la población una simulación Monte Carlo de 500 réplicas de la realización del Caso Base sin intervención farmacológica ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $B = 500$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja) hasta la absorción en $N=0$.}}{9}{}%
\contentsline {figure}{\numberline {5}{\ignorespaces Grafo de transición de estados individuales bajo intervención farmacológica. Se incorpora la tasa de curación ($\rho $) como transición reversible hacia el estado sano y la reducción de la mortalidad patológica mediante la eficacia terapéutica ($m_1(1-\alpha )$).}}{11}{}%
\contentsline {figure}{\numberline {6}{\ignorespaces Trayectoria temporal de la población en una única realización con el primer fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.3$, $\rho =0.1$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja) hasta la absorción en $N=0$.}}{15}{}%
\contentsline {figure}{\numberline {7}{\ignorespaces Trayectoria temporal de la población en múltiples realizaciones con el método de Monte Carlo con el primer fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.3$, $\rho =0.1$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja) hasta la absorción en $N=0$.}}{16}{}%
\contentsline {figure}{\numberline {8}{\ignorespaces Trayectoria temporal de la población en una única realización con el segundo fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.6$, $\rho =0.35$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja).}}{17}{}%
\contentsline {figure}{\numberline {9}{\ignorespaces Trayectoria temporal de la población en múltiples realizaciones con el método de Monte Carlo con el segundo fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.6$, $\rho =0.35$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja)}}{17}{}%
\contentsline {figure}{\numberline {10}{\ignorespaces Trayectoria temporal de la población en una única realización con el tercer fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.85$, $\rho =0.7$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja).}}{18}{}%
\contentsline {figure}{\numberline {11}{\ignorespaces Trayectoria temporal de la población en múltiples realizaciones con el método de Monte Carlo con el tercer fármaco ($N_0=1000$, $p_I=0.05$, $\lambda =1.15$, $\alpha =0.85$, $\rho =0.7$). Se observa la evolución de la población total (línea continua negra), sanos (línea punteada verde) y enfermos (línea discontinua roja).}}{19}{}%
